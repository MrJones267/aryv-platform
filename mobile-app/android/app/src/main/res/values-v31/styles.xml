<resources>
    <!-- Android 12+ always draws its own splash: the icon below on this
         background. Without these it showed the launcher icon on the theme's
         default colour. The foreground layer is the arrow on transparency,
         inside the area the splash keeps visible. -->
    <style name="LaunchTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:windowSplashScreenBackground">@color/launch_screen_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
</resources>
