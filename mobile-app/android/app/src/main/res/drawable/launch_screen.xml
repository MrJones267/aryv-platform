<?xml version="1.0" encoding="utf-8"?>
<!-- The splash on Android 11 and earlier: the ARYV arrow on white.
     Android 12+ uses the splash attributes in values-v31/styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_screen_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_screen_logo" />
    </item>
</layer-list>
