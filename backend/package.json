{
  "name": "aryv-backend",
  "version": "1.0.0",
  "description": "ARYV platform backend API services",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts --ext ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest --selectProjects unit contract",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:all": "jest",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:watch": "jest --selectProjects unit --watch",
    "coverage": "jest --selectProjects unit --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "security-audit": "npm audit --audit-level=high",
    "performance-test": "echo 'Performance testing disabled - artillery removed for security'",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "sequelize-cli db:drop && sequelize-cli db:create && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "clean": "rimraf dist coverage",
    "db:migrate:status": "tsx src/scripts/migrate.ts status",
    "db:migrate:baseline": "tsx src/scripts/migrate.ts baseline",
    "test:contract": "jest --selectProjects contract",
    "admin:create": "tsx src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/lib-storage": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@types/express-validator": "^2.20.33",
    "@types/node-cron": "^3.0.11",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.7.0",
    "google-auth-library": "^9.14.1",
    "hasown": "^2.0.2",
    "helmet": "^7.2.0",
    "joi": "^17.13.9",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.6",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "nodemailer": "~10.3.1",
    "passport": "^0.7.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "proxy-addr": "^2.0.8",
    "qrcode": "1.5.4",
    "rate-limit-redis": "^5.0.0",
    "redis": "^4.7.1",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4",
    "stripe": "^14.25.0",
    "twilio": "^6.2.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.9.0",
    "@types/node-cache": "^4.2.5",
    "@types/nodemailer": "^6.4.14",
    "@types/proxy-addr": "^2.0.3",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "sequelize-cli": "^6.6.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "types": "./dist/index.d.ts"
}
