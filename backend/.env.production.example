# ARYV Backend Production Environment Variables
# Copy this file to .env.production and fill in actual values
# These should be set in Railway dashboard or via CLI

# ===========================================
# CORE APPLICATION SETTINGS
# ===========================================
NODE_ENV=production
PORT=3001

# Number of reverse proxies between the internet and this process.
#   1  Railway's edge alone (default in production)
#   2  a proxying CDN in front of Railway, e.g. Cloudflare with the orange cloud on
# Too low and every caller shares one rate-limit bucket; too high and a client
# can forge X-Forwarded-For to get a fresh bucket per request. Never set this
# to "true".
TRUST_PROXY_HOPS=1

# When Redis is unreachable, should the API refuse authenticated requests
# rather than fall back to each instance's own record of what it revoked?
#   false (default)  keep serving; a logout handled by THIS instance still
#                    holds, but one handled elsewhere can be missed during the
#                    outage. Password resets are unaffected either way —
#                    passwordChangedAt is enforced from the database.
#   true             refuse. Certain, but a Redis blip takes the API down.
REDIS_FAIL_CLOSED=false

# ===========================================
# DATABASE CONFIGURATION  
# ===========================================
# Railway auto-provides this when PostgreSQL is added
DATABASE_URL=postgresql://postgres:password@host:port/database

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# All four are REQUIRED — the server refuses to start without them. They were
# missing from this file, so following it produced a process that exited at
# boot with "Missing required environment variables".
#
# Use a different value for each. They are separate so they can be rotated
# separately: rotating ADMIN_JWT_SECRET signs out every administrator without
# signing out a single passenger, and vice versa.
JWT_SECRET=your-super-secure-jwt-secret-key-64-characters-minimum-length-here
JWT_REFRESH_SECRET=a-different-64-byte-random-value-goes-here
ADMIN_JWT_SECRET=another-different-64-byte-random-value-signs-admin-sessions
SESSION_SECRET=a-fourth-distinct-64-byte-random-value

JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# CORS & API SECURITY
# ===========================================
CORS_ORIGIN=https://api.aryv-app.com
API_RATE_LIMIT=100
API_WINDOW_MS=900000

# ===========================================
# GOOGLE SERVICES (OPTIONAL)
# ===========================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ===========================================
# AWS S3 FILE STORAGE (OPTIONAL)
# ===========================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=aryv-production-storage

# ===========================================
# EXTERNAL SERVICES (OPTIONAL)
# ===========================================
SENDGRID_API_KEY=your-sendgrid-api-key-for-emails
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# ===========================================
# MONITORING & LOGGING (OPTIONAL)
# ===========================================
SENTRY_DSN=your-sentry-dsn-for-error-tracking
LOG_LEVEL=info

# ===========================================
# CURRENCY & COUNTRY SERVICES
# ===========================================
CURRENCY_API_KEY=your-currency-exchange-api-key
FALLBACK_CURRENCY_ENABLED=true
FALLBACK_COUNTRY_ENABLED=true

# ===========================================
# WEBSOCKET & REAL-TIME FEATURES
# ===========================================
SOCKET_CORS_ORIGIN=https://aryv-app.com,https://www.aryv-app.com
REDIS_URL=redis://localhost:6379

# ===========================================
# ENCRYPTION & QR CODES
# ===========================================
QR_SECRET_KEY=your-qr-code-encryption-secret-key
PACKAGE_ENCRYPTION_KEY=your-package-data-encryption-key

# ===========================================
# RAILWAY-SPECIFIC SETTINGS
# ===========================================
RAILWAY_STATIC_URL=https://your-app.railway.app
RAILWAY_PUBLIC_DOMAIN=api.aryv-app.com

# ===========================================
# MOBILE MONEY — BOTSWANA & REGIONAL
# ===========================================
# Orange Money (BTC / Mascom partner)
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_WEBHOOK_SECRET=

# MyZaka (First National Bank / BancABC)
MYZAKA_API_KEY=
MYZAKA_MERCHANT_CODE=
MYZAKA_WEBHOOK_SECRET=

# Smega (Smega payments Botswana)
SMEGA_API_KEY=
SMEGA_MERCHANT_ID=
SMEGA_WEBHOOK_SECRET=

# MTN Mobile Money (regional expansion)
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_KEY=
MTN_MOMO_USER_ID=

# FNB eWallet (South Africa / Botswana cross-border)
FNB_EWALLET_API_KEY=

# ===========================================
# REFERRAL SYSTEM
# ===========================================
REFERRAL_BONUS_BWP=10
# ===========================================
# VOICE CALLS — TURN RELAY
# ===========================================
# WebRTC calls fall back to relaying media through a TURN server when the two
# phones cannot reach each other directly. That is the common case on mobile
# networks behind carrier-grade NAT, so without this a meaningful share of
# calls simply never connect — they do not error, they just ring forever.
#
# Comma-separated. Include both UDP and TLS so a restrictive network still has
# a route out:
#   turn:turn.aryv-app.com:3478,turns:turn.aryv-app.com:5349
TURN_URLS=

# Preferred: coturn's shared-secret scheme (`use-auth-secret` in turnserver.conf).
# The server mints a username/password pair per user, valid four hours, so
# nothing long-lived ships inside the app.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURN_SECRET=

# Only if the TURN server uses fixed credentials instead. These never expire,
# which is why the secret above is preferred.
TURN_USERNAME=
TURN_PASSWORD=

# ===========================================
# EMERGENCY (SOS)
# ===========================================
# Emergency alerts reach a user's contacts by SMS, which works on a phone with
# no data. That path uses the Twilio credentials above — without them, pressing
# SOS stores the alert and notifies nobody.

# ===========================================
# FILE STORAGE — CLOUDFLARE R2
# ===========================================
# Uploads default to ./uploads inside the container, which Railway replaces on
# every deploy. Driver licences and ID documents were being destroyed on each
# release while their database rows still read as verified.
#
# R2 endpoint is https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional. A public base (e.g. https://cdn.aryv-app.com) for files that are
# meant to be readable, so avatars can be cached. Identity documents are never
# served this way — they always go through a short-lived signed URL.
R2_PUBLIC_BASE_URL=

# ===========================================
# TRAFFIC
# ===========================================
# Traffic conditions come from Google Distance Matrix, comparing
# duration_in_traffic against free-flow duration. Uses GOOGLE_MAPS_API_KEY
# above; the key needs the Distance Matrix API enabled. Without it the traffic
# panel is hidden rather than filled with a guess.

# ===========================================
# WEATHER — v2, NOT IMPLEMENTED
# ===========================================
# WeatherService returns null until this is set and the provider is written.
# See docs/AI.md. Weather must never feed pricing.
WEATHER_API_URL=
WEATHER_API_KEY=
